    "shimmer": 4,
    "tremor": 5,
    "wander": 6,
    "vibrato": 7,
    "growl": 8,
    "creak": 9,
    "tail_fry": 10,
    "flutter": 11,
    "rasp": 12,
    "breaks": 13,
    "size": 14,
    "pharynx": 15,
    "mouth": 16,
    "ring": 17,
    "vowel": 18,
    "style": 19,
    "attack": 20,
    "release": 21,
    "glide": 22,
    "throats": 23,
    "looseness": 24,
    "spread": 25,
    "size_spread": 26,
    "distance": 27,
    "azimuth": 28,
    "room": 29,
    "decay": 30,
    "wet": 31,
    "drive": 32,
    "body": 33,
    "air": 34,
    "level": 35,
    "grit_after": 36
