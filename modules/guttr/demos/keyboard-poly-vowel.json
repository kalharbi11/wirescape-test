{
  "SPDX-License-Identifier":"GPL-3.0-only","name":"GUTTR through host.keyboard (4 voices): each voice's pitch modulates its own note's vowel (per-voice, poly modulation cable), then release to silence","rate":48000,"block":128,"seconds":6,"seed":5,"peak_limit":1.0,
