{
  "SPDX-License-Identifier":"GPL-3.0-only","name":"MOD-3: Clock 1/8 notes into Random, stepped values play the VCO pitch","rate":48000,"block":128,"seconds":3,"seed":7,"peak_limit":1.2,
  "patch":{"format":"wirescape.native.patch","version":2,"settings":{"seed":7},"name":"Demo: Random sample and hold melody",
    "modules":[
      {"id":1,"module":"essentials.clock","version":2,"parameters":{"bpm":120,"ticks_per_beat":2,"duty":0.25}},
      {"id":2,"module":"essentials.random","version":1,"parameters":{"division":7,"depth":0.5,"slew":0.2,"seed":1234,"clock_ppq":1}},
      {"id":3,"module":"essentials.vco","version":2,"parameters":{"frequency":220}},
      {"id":4,"module":"essentials.vca","version":2,"parameters":{"gain":0.5}},
      {"id":5,"module":"essentials.output","version":2,"parameters":{}}
    ],
    "connections":[
      {"kind":"signal","from":{"module":1,"port":"clock"},"to":{"module":2,"port":"clock"}},
      {"kind":"signal","from":{"module":2,"port":"stepped"},"to":{"module":3,"port":"pitch"}},
      {"kind":"signal","from":{"module":3,"port":"audio"},"to":{"module":4,"port":"audio"}},
      {"kind":"signal","from":{"module":4,"port":"audio"},"to":{"module":5,"port":"audio"}}
    ],
    "outputs":[{"module":5,"port":"audio","bus_channel":0},{"module":5,"port":"audio","bus_channel":1}]
  },
  "events":[],
  "windows":[{"kind":"active","start":1000,"end":143000}],
  "frequencies":[]
}
